{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(sudo:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/session-start-init.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-edit-block-generated.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-edit-dispatcher-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/post-edit-targeted-tests.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/post-edit-impact-analysis.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/stop-summary.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/stop-regression-report.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/verify_answer.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/handoff-block-enforcer.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/run_hook.sh .claude/hooks/subagent-citation-check.py"
          }
        ]
      }
    ]
  }
}
